DATABASE_URL=file:./.db
# Pe Vercel: DATABASE_URL=libsql://numele-bazei.turso.io
# DATABASE_AUTH_TOKEN=tokenul-bazei-Turso
PAYLOAD_SECRET=schimba-cu-un-secret-lung-si-aleatoriu
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opțional în Docker / producție:
# UPLOAD_DIR=/app/storage/media
# BLOB_READ_WRITE_TOKEN=adăugat-automat-de-Vercel-Blob
# Notificări pe e-mail (opțional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# CRM REBS (proprietăți + vizionări/solicitări trimise în CRM):
# REBS_API_TOKEN=cheia-api-din-Administrare-Integrari-Acces-REST-API
# REBS_BASE_URL=https://lc-estate.crmrebs.com
# REBS_WEBHOOK_SECRET=whsec_... (afișat de `pnpm rebs:webhook https://domeniu.ro`)
# REBS_DEFAULT_AGENT_ID=12932 (agentul pentru mesajele fără proprietate; opțional)
